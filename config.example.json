{
  "mode": "migration",

  "history": {
    "enabled": true
  },

  "liveSync": {
    "enabled": false,
    "syncEdits": false,
    "syncDeletions": false
  },

  "channelMap": {
    "SOURCE_CHANNEL_ID_1": "DESTINATION_CHANNEL_ID_1",
    "SOURCE_CHANNEL_ID_2": "DESTINATION_CHANNEL_ID_2"
  },

  "copyAttachments": true,
  "copyLinks": true,

  "filters": {
    "images": true,
    "videos": true,
    "otherFiles": true,
    "links": true
  },

  "maxAttachmentSizeMB": 8
}